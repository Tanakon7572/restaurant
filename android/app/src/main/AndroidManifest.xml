<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Android 11 hides other packages from us unless they are named here,
        and the printer lives in one: the Sunmi service is a separate app.
        Without this the library's own lookup comes back empty, it decides
        "printer service does not exist", and the handheld reports no printer
        while Sunmi's own test app prints perfectly.

        The library targets SDK 26 and so declares nothing itself — this has
        to be in the app manifest.
    -->
    <queries>
        <package android:name="woyou.aidlservice.jiuiv5" />
        <intent>
            <action android:name="woyou.aidlservice.jiuiv5.IWoyouService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Its own launcher entry on purpose. When a receipt does not come
            out, staff need this before they can get back to selling, and
            burying it behind the POS's own menus means walking past the
            broken screen to reach the fix.
        -->
        <activity
            android:name=".PrinterSettingsActivity"
            android:exported="true"
            android:label="@string/printer_settings"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
