generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MenuCategory {
  id         Int        @id @default(autoincrement())
  name       String
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  hidden     Boolean    @default(false)
  required   Boolean    @default(true)
  selectMode String     @default("single")
  // Sub-category: set to the parent category's id. Children never appear as
  // customer tabs; a pool category's children become the option steps.
  parentId   Int?
  ingredientCategoryId Int?
  // Multi-pool links: each linked (usually hidden) category becomes one
  // option group in the DIY/Signature sheet (แป้ง / แยม / ไส้หวาน / ไส้เค็ม).
  // Supersedes ingredientCategoryId when non-empty.
  ingredientCategoryIds Int[] @default([])
  // Signature items in this category normally open with a "เลือกแป้ง" step.
  // Turn this off to drop that step (the item is then priced on its own base
  // price). DIY builders ignore the flag — there the crust IS the base item.
  showCrustStep Boolean @default(true)
  // Linked pool category ids whose derived step is hidden for Signature items
  // in this category. The ingredients stay linked (so existing orders and the
  // pool itself are untouched) — only the picker step disappears.
  hiddenPoolCategoryIds Int[] @default([])
  items      MenuItem[]
}

model MenuItem {
  id         Int           @id @default(autoincrement())
  name       String
  price      Float
  categoryId Int
  category   MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  available  Boolean       @default(true)
  order      Int           @default(0)
  imageUrl   String?
  createdAt  DateTime      @default(now())
  isSet          Boolean   @default(false)
  setCategoryIds Int[]     @default([])
  orderItems OrderItem[]
  optionGroups OptionGroup[]
}

model Order {
  id          Int         @id @default(autoincrement())
  tableNumber String?
  customerName String?
  sessionToken String?
  status      String      @default("pending")
  totalPrice  Float       @default(0)
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String    @default("")
  quantity   Int       @default(1)
  price      Float
  note       String?
  options    OrderItemOption[]
}

model AppSettings {
  id            Int     @id @default(autoincrement())
  shopName      String  @default("ร้านอาหาร")
  adminPassword String?
}

model OptionGroup {
  id         Int            @id @default(autoincrement())
  menuItemId Int
  menuItem   MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean        @default(false)
  minSelect  Int            @default(0)
  maxSelect  Int            @default(1)
  order      Int            @default(0)
  choices    OptionChoice[]
}

model OptionChoice {
  id         Int          @id @default(autoincrement())
  groupId    Int
  group      OptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Float        @default(0)
  available  Boolean      @default(true)
  order      Int          @default(0)
}

model TableReset {
  tableNumber String   @id
  resetAt     DateTime @default(now())
}

// One random ordering link per seating. The QR encodes /q?s=<token>;
// the link dies (active=false) when its orders are all finished or staff
// closes it, so old URLs can't be reused.
model TableSession {
  token       String   @id
  tableNumber String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model OrderItemOption {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  choiceName  String
  priceDelta  Float     @default(0)
}
