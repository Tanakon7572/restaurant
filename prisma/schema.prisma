generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model MenuCategory {
  id         Int        @id @default(autoincrement())
  name       String
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  hidden     Boolean    @default(false)
  required   Boolean    @default(true)
  selectMode String     @default("single")
  // Sub-category: set to the parent category's id. Children never appear as
  // customer tabs; a pool category's children become the option steps.
  parentId   Int?
  ingredientCategoryId Int?
  // Multi-pool links: each linked (usually hidden) category becomes one
  // option group in the DIY/Signature sheet (แป้ง / แยม / ไส้หวาน / ไส้เค็ม).
  // Supersedes ingredientCategoryId when non-empty.
  ingredientCategoryIds Int[] @default([])
  // Signature items in this category normally open with a "เลือกแป้ง" step.
  // Turn this off to drop that step (the item is then priced on its own base
  // price). DIY builders ignore the flag — there the crust IS the base item.
  showCrustStep Boolean @default(true)
  // Linked pool category ids whose derived step is hidden for Signature items
  // in this category. The ingredients stay linked (so existing orders and the
  // pool itself are untouched) — only the picker step disappears.
  hiddenPoolCategoryIds Int[] @default([])
  items      MenuItem[]
}

model MenuItem {
  id         Int           @id @default(autoincrement())
  name       String
  price      Float
  categoryId Int
  category   MenuCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  available  Boolean       @default(true)
  order      Int           @default(0)
  imageUrl   String?
  createdAt  DateTime      @default(now())
  isSet          Boolean   @default(false)
  setCategoryIds Int[]     @default([])
  orderItems OrderItem[]
  optionGroups OptionGroup[]
}

model Order {
  id          Int         @id @default(autoincrement())
  tableNumber String?
  customerName String?
  sessionToken String?
  status      String      @default("pending")
  totalPrice  Float       @default(0)
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  // The customer-facing number, frozen at creation. Stored rather than derived
  // from position, because deleting one order must not renumber the rest —
  // a receipt already in a customer's hand can't be reprinted.
  // `dayKey` is the Asia/Bangkok calendar day (YYYY-MM-DD) the number belongs
  // to. Both are nullable so rows predating the column keep working; Postgres
  // treats NULLs as distinct, so the unique pair tolerates them.
  dayKey      String?
  dailyNumber Int?
  // Set once the order is paid for. Orders without a bill are still open, so
  // this is what the checkout screen looks at — not `status`, which tracks
  // the kitchen.
  billId      Int?
  bill        Bill?       @relation(fields: [billId], references: [id], onDelete: SetNull)
  items       OrderItem[]

  @@unique([dayKey, dailyNumber])
  @@index([billId])
  @@index([dayKey])
}

// One row per Bangkok day holding the last number handed out. Claiming a
// number is a single INSERT … ON CONFLICT DO UPDATE, which takes a row lock,
// so two tills saving at the same instant can never be given the same number.
model DailyCounter {
  dayKey String @id
  next   Int    @default(0)
}

// One payment closing out one table. Orders are grouped into it; the money
// figures are snapshots so a later menu-price or VAT-rate change never
// rewrites history.
model Bill {
  id            Int      @id @default(autoincrement())
  tableNumber   String?
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  discountNote  String?
  serviceCharge Float    @default(0)
  vat           Float    @default(0)
  total         Float    @default(0)
  // cash | promptpay | transfer | card
  method        String   @default("cash")
  // Cash handed over and change given back; null for every other method.
  received      Float?
  changeDue     Float?
  note          String?
  // Set when the bill is voided. Voided bills reopen their orders and drop
  // out of the day's totals, but the row stays for the audit trail.
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime @default(now())
  orders        Order[]

  @@index([createdAt])
}

// Snapshot taken when staff close the day's till. Keyed by Bangkok day, so
// re-closing the same day overwrites rather than duplicating.
model DayClose {
  dayKey       String   @id
  closedAt     DateTime @default(now())
  billCount    Int      @default(0)
  totalSales   Float    @default(0)
  expectedCash Float    @default(0)
  countedCash  Float    @default(0)
  note         String?
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  itemName   String    @default("")
  quantity   Int       @default(1)
  price      Float
  note       String?
  options    OrderItemOption[]
}

model AppSettings {
  id            Int     @id @default(autoincrement())
  shopName      String  @default("ร้านอาหาร")
  adminPassword String?
  // none = ไม่คิด VAT | included = ราคาเมนูรวม VAT แล้ว (แยกให้ดูในใบเสร็จ)
  // added = บวก VAT เพิ่มจากยอด
  vatMode           String  @default("none")
  vatRate           Float   @default(7)
  serviceChargeRate Float   @default(0)
  // Phone number or national/tax id. Empty = no PromptPay QR is offered.
  promptPayId       String?
  // Free text printed above the items (address, tax id) and at the foot.
  receiptHeader     String?
  receiptFooter     String?
  // Thermal paper width in mm: 58 or 80.
  receiptWidth      Int     @default(58)
}

model OptionGroup {
  id         Int            @id @default(autoincrement())
  menuItemId Int
  menuItem   MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean        @default(false)
  minSelect  Int            @default(0)
  maxSelect  Int            @default(1)
  order      Int            @default(0)
  choices    OptionChoice[]
}

model OptionChoice {
  id         Int          @id @default(autoincrement())
  groupId    Int
  group      OptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  priceDelta Float        @default(0)
  available  Boolean      @default(true)
  order      Int          @default(0)
}

model TableReset {
  tableNumber String   @id
  resetAt     DateTime @default(now())
}

// One random ordering link per seating. The QR encodes /q?s=<token>;
// the link dies (active=false) when its orders are all finished or staff
// closes it, so old URLs can't be reused.
model TableSession {
  token       String   @id
  tableNumber String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model OrderItemOption {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  choiceName  String
  priceDelta  Float     @default(0)
}
